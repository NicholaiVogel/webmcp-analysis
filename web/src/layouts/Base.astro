---
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/inter';
import '../styles/global.css';
import { FORMAT } from '../components/format';

interface Props {
  title: string;
  description?: string;
  active?: 'rankings' | 'explore' | 'volume' | 'methodology' | 'about';
  hero?: { eyebrow: string; title: string; lede?: string };
  /** suppress the default hero paddings for full-bleed pages */
  compact?: boolean;
}
const { title, description = 'Independent qualitative analysis of roughly 2,500 WebMCP Challenge submissions.', active, hero, compact } = Astro.props;
const pagePath = `${Astro.url.pathname}${Astro.url.search}`;
const pageUrl = Astro.site ? new URL(pagePath, Astro.site).href : pagePath;
const socialImage = Astro.site ? new URL('/social-preview.png', Astro.site).href : '/social-preview.png';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="webmcp/analysis" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1370" />
    <meta property="og:image:height" content="1035" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="WebMCP Challenge Predictive Rankings" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="WebMCP Challenge Predictive Rankings" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ClientRouter />
  </head>
  <body>
    <header class="masthead masthead-transparent">
      <div class="wrap masthead-inner">
        <a class="wordmark" href="/">webmcp<span class="slash">/</span><span class="sub">analysis</span></a>
        <nav class="nav" aria-label="Main">
          <a href="/" aria-current={active === 'rankings' ? 'page' : undefined}>Rankings</a>
          <a href="/explore/" aria-current={active === 'explore' ? 'page' : undefined}>Explore</a>
          <a href="/volume/" aria-current={active === 'volume' ? 'page' : undefined}>Volume</a>
          <a href="/methodology/" aria-current={active === 'methodology' ? 'page' : undefined}>Methodology</a>
          <a href="/about/" aria-current={active === 'about' ? 'page' : undefined}>About</a>
        </nav>
      </div>
    </header>
    <main class={compact ? undefined : undefined}>
      {hero ? (
        <section class="hero hero-texture">
          <div class="wrap hero-row">
            <div>
              <p class="eyebrow">{hero.eyebrow}</p>
              <h1>{hero.title}</h1>
              {hero.lede ? <p class="lede">{hero.lede}</p> : null}
            </div>
          </div>
        </section>
      ) : null}
      <slot />
    </main>
    <footer class="footer">
      <div class="wrap">
        <span>Independent, unofficial analysis. Not affiliated with the WebMCP Challenge or Devpost.</span>
        <span>{FORMAT.TOTAL} submissions · four equally weighted criteria · two blind reviews per project</span>
      </div>
    </footer>
  </body>
</html>
