---
import Base from '../../layouts/Base.astro';
import { loadProjects } from '../../data/load-projects';
import { score, trunc, verificationLabel, originLabel, accessLabel, CRITERION_SHORT, FORMAT } from '../../components/format';

export async function getStaticPaths() {
  return loadProjects().map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props;
const title = p.title || p.slug;
const reviews = p.reviews.slice(0, 2);
const crits = ['leverage', 'execution', 'impact', 'creativity'] as const;
const probe = p.media.probeBefore || p.media.probeAfter;

// agreement-at-a-glance: for each criterion, gap between the two blind scores
function gapOf(c: string): number | null {
  if (reviews.length < 2) return null;
  const a = reviews[0].criteria[c as keyof typeof reviews[0]['criteria']]?.score;
  const b = reviews[1].criteria[c as keyof typeof reviews[1]['criteria']]?.score;
  if (a == null || b == null) return null;
  return Math.abs(a - b);
}
const gaps = Object.fromEntries(crits.map((c) => [c, gapOf(c)]));
---
<Base title={`${title} — webmcp/analysis`} description={trunc(p.pitch, 150) ?? undefined}>
  <div class="wrap">
    <nav aria-label="Breadcrumb" style="padding: 22px 0 0; font-size: var(--text-sm); color: var(--ink-3);">
      <a href="/" style="color: var(--ink-2);">Rankings</a> <span aria-hidden="true">/</span> {p.rank ? `#${p.rank}` : 'not in final dataset'}
    </nav>

    <section class="hero" style="padding-bottom: 8px;">
      <div class="hero-row">
        <div>
          <h1 style="margin-bottom: 8px;">{title}</h1>
          <p class="lede">{p.pitch ?? ''}</p>
        </div>
        <div class="meta-stack">
          {p.rank ? <span class="chip accent"><span class="dot"></span>Rank {p.rank} of {FORMAT.RANKED}</span> : <span class="chip">Not in final dataset</span>}
          <span class="chip">{p.finalStage === 'S2' ? 'Stage 2 · live-product evidence' : 'Stage 1 · packet evidence only'}</span>
          {p.webmcpVerification ? <span class="chip">{verificationLabel(p.webmcpVerification)}</span> : null}
        </div>
      </div>
    </section>

    <section style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1px; background: var(--border); border: 1px solid var(--border); border-radius: 10px; overflow: hidden; margin: 18px 0 8px;">
      {[
        { label: 'Aggregate', value: score(p.scores.aggregate), strong: true },
        ...crits.map((c) => ({ label: CRITERION_SHORT[c], value: score(p.scores[c]), strong: false })),
      ].map((x: { label: string; value: string; strong: boolean }) => (
        <div style="background: var(--canvas); padding: 14px 16px;">
          <div style="font-size: var(--text-xs); color: var(--ink-3);">{x.label}</div>
          <div style={`font-size: ${x.strong ? 'var(--text-2xl)' : 'var(--text-lg)'}; font-weight: 600; font-variant-numeric: tabular-nums;`}>{x.value}</div>
          {x.value === '—' ? <div style="font-size: var(--text-2xs); color: var(--ink-3); margin-top: 2px;">withheld — reviewers differ</div> : null}
        </div>
      ))}
    </section>
    <p style="color: var(--ink-3); font-size: var(--text-xs); margin: 0 0 26px;">
      Each criterion 1–10, equally weighted; aggregate is their sum. Ranking is the pipeline's consolidated output.
    </p>

    <section>
      <p class="sec-mark"><span class="n">01</span> The two blind reviews</p>
      <p style="color: var(--ink-2); margin: 0 0 12px; max-width: var(--measure);">
        Two independent reviewers scored this project blind, from a sanitized evidence packet.
        <span class="dim">A dashed cell below means they differed by more than 2 points: the score is withheld, never averaged, never zero.</span>
      </p>
      {reviews.length === 2 ? (
        <div class="agree-bar" role="list" aria-label="Reviewer agreement per criterion">
          {crits.map((c) => {
            const g = gaps[c];
            const cls = g == null ? 'na' : g > 2 ? 'warn' : 'ok';
            const word = g == null ? 'n/a' : g > 2 ? `differs by ${g}` : 'agreed';
            return (
              <span class="agree-cell" role="listitem" title={`${CRITERION_SHORT[c]}: reviewers ${word}`}>
                <span class={`sw ${cls}`} aria-hidden="true"></span>
                {CRITERION_SHORT[c]} <span class="dim">· {word}</span>
              </span>
            );
          })}
        </div>
      ) : null}
      <div class="review-grid">
        {reviews.map((rev, idx) => (
          <article class={`review-card r${idx + 1}`}>
            <header style="display: flex; justify-content: space-between; align-items: baseline; gap: 10px; margin-bottom: 10px;">
              <h3 style="margin: 0; font-size: var(--text-sm); font-weight: 600;">{rev.reviewerLabel}</h3>
              <span style="color: var(--ink-3); font-size: var(--text-xs);">confidence {rev.overallConfidence == null ? '—' : `${Math.round(rev.overallConfidence * 100)}%`}</span>
            </header>
            <dl style="margin: 0;">
              {crits.map((c) => (
                <div style="padding: 9px 0; border-top: 1px solid var(--border);">
                  <div style="display: flex; justify-content: space-between; gap: 10px; align-items: baseline;">
                    <dt style="font-weight: 550; font-size: var(--text-sm);">{CRITERION_SHORT[c]}</dt>
                    <dd style="margin: 0; font-variant-numeric: tabular-nums; font-weight: 600;">{rev.criteria[c].score}<span style="color: var(--border-strong); font-weight: 400;"> /10</span></dd>
                  </div>
                  <p style="margin: 4px 0 0; color: var(--ink-2); font-size: var(--text-sm);">{rev.criteria[c].rationale}</p>
                  {rev.criteria[c].evidence.length ? (
                    <div style="margin-top: 8px;">
                      <div style="font-size: var(--text-2xs); font-weight: 550; color: var(--ink-3); margin-bottom: 2px;">Evidence cited</div>
                      <ul style="margin: 0; padding-inline-start: 18px; color: var(--ink-3); font-size: var(--text-xs); border-inline-start: 2px solid var(--border);">
                        {rev.criteria[c].evidence.map((ev) => <li style="margin: 3px 0;">{ev}</li>)}
                      </ul>
                    </div>
                  ) : null}
                </div>
              ))}
            </dl>
          </article>
        ))}
        {p.reviews.length === 0 ? <p style="color: var(--ink-2);">No Stage 1 reviews are available for this project yet.</p> : null}
      </div>
    </section>

    {(p.standouts.length || p.redFlags.length) ? (
    <section style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 18px; margin: 34px 0;">
      {p.standouts.length ? (
        <div>
          <p class="sec-mark"><span class="n">02</span> Standouts across reviewers</p>
          <ul style="margin: 0; padding-inline-start: 20px; color: var(--ink-2); font-size: var(--text-sm);">{p.standouts.map((s) => <li style="margin: 4px 0;">{s}</li>)}</ul>
        </div>
      ) : null}
      {p.redFlags.length ? (
        <div>
          <p class="sec-mark" style="color: var(--accent-ink);"><span class="n" style="color: var(--accent-ink);">03</span> Red flags</p>
          <ul style="margin: 0; padding-inline-start: 20px; color: var(--ink-2); font-size: var(--text-sm);">{p.redFlags.map((s) => <li style="margin: 4px 0;">{s}</li>)}</ul>
        </div>
      ) : null}
    </section>
    ) : null}

    <section style="border-top: 1px solid var(--border); padding-top: 24px; margin-top: 8px;">
      <p class="sec-mark"><span class="n">{p.standouts.length || p.redFlags.length ? '04' : '02'}</span> Evidence</p>
      <p style="color: var(--ink-2); margin: 0 0 14px; max-width: var(--measure);">
        What each artifact proves is labeled on the artifact itself. A Devpost page capture is packaging evidence, not proof the product runs;
        video frames are evidence from the submitted demo, not live verification.
        {probe ? ' Probe captures come from Stage 2 interactive testing of the live product by a reviewer.' : ''}
      </p>
      <div class="ev-grid">
        {p.media.devpostScreenshot ? (
          <figure class="ev ev-primary">
            <a href={`/media/devpost/${p.slug}.png`} target="_blank" rel="noopener noreferrer">
              <img src={`/media/devpost/${p.slug}.png`} alt={`Devpost page capture for ${title}`} loading="lazy" width="800" height="500" />
            </a>
            <figcaption>
              <span class="ev-id">EX-01</span> Devpost page capture · packaging evidence, not runtime proof
              {p.links.devpost ? <span class="ev-src"> · <a href={p.links.devpost} target="_blank" rel="noopener noreferrer">source</a></span> : null}
            </figcaption>
          </figure>
        ) : null}
        {p.media.probeBefore ? (
          <figure class="ev">
            <a href={`/media/probe/${p.slug}-before.png`} target="_blank" rel="noopener noreferrer">
              <img src={`/media/probe/${p.slug}-before.png`} alt={`Live probe of ${title} before interaction`} loading="lazy" width="800" height="500" />
            </a>
            <figcaption><span class="ev-id">EX-02</span> Live probe at Stage 2 · observed product behavior, reviewer-driven</figcaption>
          </figure>
        ) : null}
        {p.media.probeAfter ? (
          <figure class="ev">
            <a href={`/media/probe/${p.slug}-after.png`} target="_blank" rel="noopener noreferrer">
              <img src={`/media/probe/${p.slug}-after.png`} alt={`Live probe of ${title} after interaction`} loading="lazy" width="800" height="500" />
            </a>
            <figcaption><span class="ev-id">EX-03</span> Live probe after interaction · observed product behavior</figcaption>
          </figure>
        ) : null}
        {!p.media.devpostScreenshot && !probe ? <p style="color: var(--ink-2);">No screenshots available for this project.</p> : null}
      </div>
      {p.media.videoFrameSheets.length ? (
        <div style="margin-top: 18px;">
          <p class="sec-mark" style="margin-top: 6px;"><span class="n">EX-V</span> Submitted demo video {p.corpus.videoTitle ? <span class="dim">— “{p.corpus.videoTitle}”</span> : null}</p>
          <p style="color: var(--ink-3); font-size: var(--text-xs); margin: 0 0 10px;">
            Contact sheets from the {p.corpus.videoDurationSecs ?? '?'}s video the team submitted. This is what reviewers were shown;
            it demonstrates the product in motion but is not independent verification.
            {p.links.video ? <span> · <a href={p.links.video} target="_blank" rel="noopener noreferrer">watch the original</a></span> : null}
          </p>
          <div class="ev-grid">
            {p.media.videoFrameSheets.slice(0, 4).map((sheet, i) => (
              <figure class="ev">
                <a href={`/media/frames/${p.slug}/${i}.jpg`} target="_blank" rel="noopener noreferrer">
                  <img src={`/media/frames/${p.slug}/${i}.jpg`} alt={`Contact sheet ${i + 1} from the ${title} demo video`} loading="lazy" width="640" height="360" />
                </a>
                <figcaption><span class="ev-id">EX-V{i + 1}</span> Sheet {i + 1} of {p.media.videoFrameSheets.length} · reported video evidence</figcaption>
              </figure>
            ))}
          </div>
        </div>
      ) : null}
    </section>

    <section style="border-top: 1px solid var(--border); padding: 24px 0 60px; margin-top: 26px;">
      <p class="sec-mark"><span class="n">{p.standouts.length || p.redFlags.length ? '05' : '03'}</span> Links & metadata</p>
      <div style="display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 16px;">
        {p.links.devpost ? <a class="btn primary" href={p.links.devpost} target="_blank" rel="noopener noreferrer">View on Devpost</a> : null}
        {p.links.live ? <a class="btn" href={p.links.live} target="_blank" rel="noopener noreferrer">Open live project</a> : null}
        {p.links.repository ? <a class="btn" href={p.links.repository} target="_blank" rel="noopener noreferrer">View repository</a> : null}
        {p.links.video ? <a class="btn" href={p.links.video} target="_blank" rel="noopener noreferrer">Watch demo video</a> : null}
      </div>
      <table class="meta-table">
        <tbody>
          <tr><td>Category (both reviewers)</td><td>{p.categories.length ? p.categories.join(' / ') : '—'}</td></tr>
          <tr><td>Project origin</td><td>{p.origin.filter(Boolean).map(originLabel).join(' / ') || '—'}</td></tr>
          <tr><td>Access model</td><td>{accessLabel(p.access) || '—'}</td></tr>
          <tr><td>Eligibility read</td><td>{p.eligibility.filter(Boolean).join(' / ') || '—'}</td></tr>
          <tr><td>Substitution class <span title="Diagnostic: could a general agent replicate this without WebMCP? Not a judging criterion.">ⓘ</span></td><td>{p.substitution.filter(Boolean).join(' / ') || '—'}</td></tr>
          <tr><td>Demo liveness at collection</td><td>{p.corpus.demoAlive ?? '—'}</td></tr>
        </tbody>
      </table>
      <p style="color: var(--ink-3); font-size: var(--text-xs); max-width: var(--measure);">
        Origin, access model, eligibility, and substitution are diagnostics recorded by reviewers. They are metadata, not judging criteria, and never entered the scores.
        Authentication requirements are not penalized anywhere in this analysis.
      </p>
    </section>
  </div>
</Base>
